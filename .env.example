# Salin menjadi .env di server (jangan commit .env).
# Berkas ini hanya berisi nama variabel; isi nilainya di server.

# Akun super admin. Dibaca includes/super-admin.php dengan getenv(),
# lalu disimpan/diverifikasi sebagai hash (password_hash / password_verify).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_NAME=
SUPER_ADMIN_PASSWORD=
